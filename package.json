{
  "name": "8sme-tools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Tools for 8 Star Metal Engineering - CNC tube laser workflow helpers",
  "scripts": {
    "preinstall": "only-allow pnpm",
    "dev": "vite",
    "generate": "tsr generate",
    "build": "tsr generate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "biome check --write",
    "lint": "tsr generate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run format",
    "pre-push": "pnpm run lint"
  },
  "packageManager": "pnpm@12.10.1",
  "dependencies": {
    "@tanstack/react-router": "^1.170.41",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.53.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "replicad": "^1.1.0",
    "replicad-opencascadejs": "^1.1.0",
    "replicad-threejs-helper": "^1.0.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-cli": "^1.167.40",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "only-allow": "^1.2.2",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
